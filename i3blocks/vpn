#!/bin/bash

# Variables
symbol=
color=
message=
exists=

# Check for button clicks
if [ -n "${BLOCK_BUTTON}" ]
then
	IFS=$'\n'
	info=$(curl -s ipinfo.io)
	city=$(echo "${info[@]}" | grep city | cut -f 4 -d '"' | tr -d '"')
	region=$(echo "${info[@]}" | grep region | cut -f 4 -d '"' | tr -d '"')
	countryCode=$(echo "${info[@]}" | grep country | cut -f 4 -d '"' | tr -d '"')
	country=$(grep -Po "\"${countryCode}\": \"\K[^\"]+" /home/gabeg/.config/i3blocks/countries.json)
	notify-send -t 4000 --icon=applications-internet \
		"${country}" "${city}, ${region}"
fi

# Check for the existence of a VPN tunnel
#for d in /sys/class/net/{tun*,pvpn*,proton*,*-*}
for d in /sys/class/net/{tun*,pvpn*,proton*}
do
	if [ -d "${d}" ]
	then
		exists=true
		break
	fi
done

# Set symbol and message based on existence of VPN tunnel
if [ -n "${exists}" ]
then
	color="#00cd00"
	symbol=""
	message="VPN connected"
else
	color="#ff0000"
	symbol=""
	message="VPN disconnected"
fi

echo "  <span color='${color}' font='monospace'>${symbol} ${message}</span>   "
echo "  <span color='${color}' font='monospace'>${symbol} ${message}</span>   "
echo 
